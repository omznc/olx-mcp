# Nije obavezno — preporučeni način prijave je `npx -y @omznc/olx-mcp login`,
# koji sačuva token u ~/.config/olx-mcp/auth.json.
#
# Ove varijable su za CI i slučajeve bez terminala. Imaju prioritet nad sačuvanim tokenom.

# 1. Gotov bearer token (iz POST /auth/login).
OLX_TOKEN=

# 2. Kredencijali — server se sam prijavi pri prvom pozivu koji traži autentikaciju,
#    i sam obnovi token ako ga OLX odbije.
OLX_USERNAME=
OLX_PASSWORD=

# 3. Stari način autentikacije.
OLX_CLIENT_ID=
OLX_CLIENT_TOKEN=

# Opcionalno.
# OLX_BASE_URL=https://api.olx.ba
# OLX_MCP_CONFIG_DIR=/putanja/do/foldera
# OLX_TIMEOUT_MS=30000
